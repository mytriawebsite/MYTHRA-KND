rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    function validInitialState() {
      let data = request.resource.data;
      let rackIds = [
        'slot_1', 'slot_2', 'slot_3', 'slot_4',
        'slot_5', 'slot_6', 'slot_7', 'slot_8',
        'slot_9', 'slot_10', 'slot_11', 'slot_12',
        'slot_13', 'slot_14', 'slot_15', 'slot_16'
      ];

      return data.keys().hasOnly([
          'balance', 'accountType', 'inventory',
          'room', 'createdAt', 'updatedAt'
        ])
        && data.balance == 0
        && data.accountType == 'JOGADOR'
        && data.inventory is map
        && data.inventory.keys().hasOnly(['racks', 'miners'])
        && data.inventory.racks is map
        && data.inventory.racks.size() == 0
        && data.inventory.miners is map
        && data.inventory.miners.size() == 0
        && data.room is map
        && data.room.keys().hasOnly(['racks'])
        && data.room.racks is map
        && data.room.racks.keys().hasOnly(rackIds)
        && data.room.racks.size() == 16
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validIncrement(beforeMap, afterMap, itemId) {
      let oldQty = beforeMap.get(itemId, 0);
      let newQty = afterMap.get(itemId, 0);
      return oldQty is int
        && newQty is int
        && newQty > oldQty
        && newQty - oldQty <= 99;
    }

    function validCatalogChange(beforeMap, afterMap, allowedIds) {
      let changed = afterMap.diff(beforeMap).affectedKeys();
      return changed.size() == 1
        && changed.hasOnly(allowedIds)
        && (
          (changed.hasOnly(['rack_1001']) && validIncrement(beforeMap, afterMap, 'rack_1001')) ||
          (changed.hasOnly(['rack_1002']) && validIncrement(beforeMap, afterMap, 'rack_1002')) ||
          (changed.hasOnly(['rack_1003']) && validIncrement(beforeMap, afterMap, 'rack_1003')) ||
          (changed.hasOnly(['rack_1004']) && validIncrement(beforeMap, afterMap, 'rack_1004')) ||
          (changed.hasOnly(['miner_2001']) && validIncrement(beforeMap, afterMap, 'miner_2001')) ||
          (changed.hasOnly(['miner_2002']) && validIncrement(beforeMap, afterMap, 'miner_2002')) ||
          (changed.hasOnly(['miner_2003']) && validIncrement(beforeMap, afterMap, 'miner_2003')) ||
          (changed.hasOnly(['miner_2004']) && validIncrement(beforeMap, afterMap, 'miner_2004'))
        );
    }


    function validRoomOperation() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();

      return changed.hasOnly(['room', 'inventory', 'updatedAt'])
        && changed.hasAll(['room', 'inventory', 'updatedAt'])
        && after.balance == before.balance
        && after.accountType == before.accountType
        && after.createdAt == before.createdAt
        && after.updatedAt == request.time
        && after.room is map
        && after.room.keys().hasOnly(['racks'])
        && after.room.racks is map
        && after.inventory is map
        && after.inventory.keys().hasOnly(['racks', 'miners'])
        && after.inventory.racks is map
        && after.inventory.miners is map;
    }

    function validPurchase() {
      let before = resource.data;
      let after = request.resource.data;

      return after.diff(before).affectedKeys()
          .hasOnly(['inventory', 'updatedAt'])
        && after.diff(before).affectedKeys()
          .hasAll(['inventory', 'updatedAt'])
        && after.balance == before.balance
        && after.updatedAt == request.time
        && after.inventory is map
        && after.inventory.keys().hasOnly(['racks', 'miners'])
        && (
          (
            validCatalogChange(
              before.inventory.racks,
              after.inventory.racks,
              ['rack_1001', 'rack_1002', 'rack_1003', 'rack_1004']
            )
            && after.inventory.miners == before.inventory.miners
          )
          || (
            validCatalogChange(
              before.inventory.miners,
              after.inventory.miners,
              ['miner_2001', 'miner_2002', 'miner_2003', 'miner_2004']
            )
            && after.inventory.racks == before.inventory.racks
          )
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'playerId',
          'createdAt'
        ]);

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['playerId']);

      allow delete: if false;

      match /game/state {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validInitialState();
        allow update: if isOwner(userId) && (validPurchase() || validRoomOperation());
        allow delete: if false;
      }

      match /game/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
