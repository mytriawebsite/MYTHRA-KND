{
  "firestore": {
    "rules": "firestore.rules.emulator-test"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9100
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5002
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8081
    },
    "ui": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 4001
    },
    "singleProjectMode": true,
    "hub": {
      "port": 4402
    },
    "logging": {
      "port": 4502
    }
  }
}
